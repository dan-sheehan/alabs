{
  "name": "alabs",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "build:browser": "tsc && ALABS_RUNTIME=browser vite build --outDir dist-browser --emptyOutDir",
    "browser": "node scripts/browser.mjs",
    "pretest:browser": "npm run build:browser && cargo build --release --manifest-path src-tauri/Cargo.toml --no-default-features --features serve --bin alabs-serve",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "dexie": "4.4.6",
    "dompurify": "^3.4.8",
    "marked": "^14.0.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
